#!/bin/bash
#PBS -N soil_fba_all
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=72:00:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"

module load tools/prod
module load miniforge/3

eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate tpc-fba

python scripts/check_fba_environment.py

python scripts/run_fba_anchor_latitude.py \
  --analysis-records outputs/soil_latitude_main_80_20_pipeline/latitude_trait_analysis_80_20/analysis_records_with_tpc_traits.csv \
  --species-curves outputs/soil_latitude_main_80_20_pipeline/ogt_tpc_371_local/species_tpc_curves_long.csv \
  --medium external_fp_code_v3/examples/example_medium_ecoli.json \
  --out-dir outputs/soil_latitude_main_80_20_pipeline/fba_anchor_latitude_all \
  --all \
  --universe bacteria \
  --gapfill-medium M9 \
  --init-medium M9
